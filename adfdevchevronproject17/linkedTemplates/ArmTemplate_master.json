					},
					"LS_SRC_EXCEL_accountKey": {
						"value": "[parameters('LS_SRC_EXCEL_accountKey')]"
					},
					"LS_SQLSERVER_ONPREMISE_password": {
						"value": "[parameters('LS_SQLSERVER_ONPREMISE_password')]"
					},
					"LS_REST_API_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_API_properties_typeProperties_url')]"
					},
					"LS_SINK_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('LS_SINK_PARQUET_properties_typeProperties_url')]"
					},
					"LS_SRC_EXCEL_properties_typeProperties_url": {
						"value": "[parameters('LS_SRC_EXCEL_properties_typeProperties_url')]"
					},
					"LS_SQLSERVER_ONPREMISE_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLSERVER_ONPREMISE_properties_typeProperties_server')]"
					},
					"LS_SQLSERVER_ONPREMISE_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLSERVER_ONPREMISE_properties_typeProperties_database')]"
					},
					"LS_SQLSERVER_ONPREMISE_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLSERVER_ONPREMISE_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfdevchevronproject17_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"event trigger_properties_typeProperties_scope": {
						"value": "[parameters('event trigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfdevchevronproject17_ArmTemplate_0')]"
			]
		}
	]
}