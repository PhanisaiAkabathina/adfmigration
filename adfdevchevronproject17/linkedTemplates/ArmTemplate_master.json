{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevchevronproject17"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"LS_SINK_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SINK_PARQUET'"
		},
		"LS_SQLSERVER_ONPREMISE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLSERVER_ONPREMISE'"
		},
		"LS_SRC_EXCEL_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SRC_EXCEL'"
		},
		"LS_REST_API_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retoolapi.dev/5yDVOt/data"
		},
		"LS_SINK_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevsinkstorage17.dfs.core.windows.net/"
		},
		"LS_SQLSERVER_ONPREMISE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "PHANI-SAI,1433"
		},
		"LS_SQLSERVER_ONPREMISE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2025"
		},
		"LS_SQLSERVER_ONPREMISE_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"LS_SRC_EXCEL_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevexcelsource17.dfs.core.windows.net/"
		},
		"event trigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/458b5fb6-21e1-42ca-930e-7e879878426e/resourceGroups/rgdevchevronproject/providers/Microsoft.Storage/storageAccounts/adlsdevexcelsource17"
		},
